{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "installCommand": "npm install",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "functions": {
    "api/index.py": {
      "maxDuration": 300,
      "includeFiles": "{app.py,highlight_export.py,RECO FORMAT.xlsx}"
    },
    "api/blob-upload.ts": {
      "maxDuration": 30
    }
  },
  "rewrites": [
    { "source": "/api/run", "destination": "/api/index" },
    { "source": "/api/health", "destination": "/api/index" }
  ]
}
